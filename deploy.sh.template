#!/bin/bash
# Пример деплой-скрипта с блокировкой, чтобы два параллельных Codex-процесса
# (от разных коллег) не деплоили одновременно.
# Скопируйте в корень проекта как deploy.sh, поправьте команды под свой стек.
set -euo pipefail

LOCK_FILE="/opt/project-repo/.deploy.lock"

(
  flock -w 120 200 || { echo "Не удалось получить lock за 120с, деплой уже идёт"; exit 1; }

  echo "== Прогоняем тесты =="
  # npm test / pytest / go test ./... — замените на реальную команду
  <ЗАМЕНИТЕ НА КОМАНДУ ТЕСТОВ>

  echo "== Собираем и разворачиваем =="
  # docker compose up -d --build / systemctl restart myservice / и т.д.
  <ЗАМЕНИТЕ НА КОМАНДУ ДЕПЛОЯ>

  echo "== Деплой завершён =="
) 200>"$LOCK_FILE"
