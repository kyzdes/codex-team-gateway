# Проект клиента
PROJECT_REPO=kyzdes/cvetbiz
PROJECT_BASE_BRANCH=main
PROJECT_PROD_URL=https://cvetbiz.digital
PROJECT_HEALTH_PATH=/healthz
# Локальный прогон тестов до пуша. Пусто = полагаемся на GitHub Actions.
# Включать только если тулчейн проекта есть в контейнере шлюза.
PROJECT_TEST_CMD=

# Доступ к GitHub. Fine-grained PAT на один репозиторий:
#   Contents: Read and write, Pull requests: Read and write
GITHUB_TOKEN=github_pat_...
GITHUB_REQUIRED_CHECK=tests
GITHUB_MERGE_METHOD=squash

# Авторизация Codex: либо ключ, либо разовый codex login --device-auth в контейнере
CODEX_API_KEY=

# Люди: login:Имя через запятую. Только затравка первого запуска — дальше
# сотрудников заводят и отключают в админке, и это действует сразу.
USERS=anna:Анна Петрова,oleg:Олег Смирнов
ADMIN_TOKEN=сгенерируйте-длинную-строку

# Кто подтверждает выкатку: user — автор заявки, admin — только администратор
APPROVAL_POLICY=user
# Потолок заявок на человека в час (0 — без ограничения). Админа не касается
RATE_LIMIT_PER_HOUR=20
# Сколько мегабайт картинок держим на человека: черновики плюс всё,
# что уже приложено к его заявкам и ещё не вычищено по сроку хранения
UPLOAD_QUOTA_MB=64
# Сколько дней храним логи агента и картинки давно закрытых заявок
RETENTION_DAYS=60

# Витрина
BRAND_NAME=Правки
BRAND_SUBTITLE=cvetbiz.digital
BRAND_ACCENT=#3f6fff

# Агент
CODEX_SANDBOX=workspace-write
CODEX_NETWORK_ACCESS=true
MAX_CONCURRENT_RUNS=2

# Точный статус выкатки (необязательно)
DOKPLOY_URL=
DOKPLOY_TOKEN=
DOKPLOY_APPLICATION_ID=
